{
  "name": "school-billing",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "node scripts/dev-db.mjs",
    "db:generate": "pnpm --filter @sb/db generate",
    "db:migrate": "pnpm --filter @sb/db migrate",
    "db:seed": "pnpm --filter @sb/db seed",
    "dev": "pnpm --parallel --filter @sb/web --filter @sb/worker run dev",
    "dev:web": "pnpm --filter @sb/web dev",
    "dev:worker": "pnpm --filter @sb/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @sb/core test",
    "check": "pnpm typecheck && pnpm test",
    "new-school": "tsx packages/db/src/setup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^16.5.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
