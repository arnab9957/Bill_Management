# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://billing:billing@127.0.0.1:5433/school_billing
# 32+ random characters; encrypts provider API keys and signs sessions
APP_SECRET=change-me-to-a-long-random-string-of-32-chars
STORAGE_DIR=./storage
# Path to pg_dump for backups (installed PostgreSQL bin folder)
PG_DUMP_PATH=pg_dump
SESSION_IDLE_MINUTES=30
NEXT_TELEMETRY_DISABLED=1
